*.dll
*.exe
.DS_Store
example.tf
terraform.tfplan
terraform.tfstate
bin/
dist/
modules-dev/
/pkg/
website/.vagrant
website/.bundle
website/build
website/node_modules
.vagrant/
*.backup
./*.tfstate
.terraform/
*.log
*.bak
*~
.*.swp
.idea
*.iml
*.test
*.iml

website/vendor
vendor

# Test exclusions
!command/test-fixtures/**/*.tfstate
!command/test-fixtures/**/.terraform/

# Keep windows files with windows line endings
*.winfile eol=crlf
# --- Additional ignores: local lockfile + hidden/sensitive files ---
# Local provider lock file (these modules pin via versions.tf; never commit a
# lock from a local/prerelease provider build).
.terraform.lock.hcl

# tfvars may contain secrets (re-stated; duplicate-safe for repos already covering it)
*.tfvars
*.tfvars.json

# OS / editor hidden files
.DS_Store
*.swp
*~

# Secrets / credentials / env
.env
*.env
*.pem
*.key
